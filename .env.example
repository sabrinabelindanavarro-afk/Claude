# Supabase (login + catálogo de propiedades sin código)
# Dashboard del proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (cobro de fianza + comisión)
# Dashboard → Developers → API keys (usá la de modo test primero)
STRIPE_SECRET_KEY=

# Didit (verificación de identidad / KYC)
# Dashboard de Didit → API keys, y el workflow que crees para el flujo de verificación
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=

# URL pública del sitio (para construir los links de vuelta desde Stripe/Didit)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
