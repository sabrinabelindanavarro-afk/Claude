# Supabase (login + catálogo de propiedades sin código)
# Dashboard del proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La "service_role" key (misma pantalla, más abajo). Solo la usa el panel /admin
# en el servidor — NUNCA la copies a NEXT_PUBLIC_* ni la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Emails con acceso al panel interno /admin (separados por coma)
ADMIN_EMAILS=vos@tuempresa.com

# Stripe y Didit son OPCIONALES acá: se pueden cargar directamente desde
# /admin/integraciones una vez logueado como admin, sin tocar variables de
# entorno ni redesplegar. Estas quedan como alternativa/valor por defecto —
# lo que cargues desde el panel siempre tiene prioridad.

# Stripe (cobro de fianza + comisión)
# Dashboard → Developers → API keys (usá la de modo test primero)
STRIPE_SECRET_KEY=

# Didit (verificación de identidad / KYC)
# Dashboard de Didit → API keys, y el workflow que crees para el flujo de verificación
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=

# URL pública del sitio. Ya no es obligatoria (las rutas de Stripe/Didit resuelven
# el dominio real de la petición), pero sirve como respaldo si hiciera falta.
NEXT_PUBLIC_SITE_URL=
